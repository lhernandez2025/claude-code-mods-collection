{
  // Static site on Workers static assets: no Worker script runs, so every request is free
  "name": "better-claude",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "betterclaude.dev", "custom_domain": true }],
  // Serve only on betterclaude.dev, so Google never indexes a duplicate copy
  "workers_dev": false,
  "preview_urls": false
}
